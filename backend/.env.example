# Backend environment configuration
NODE_ENV=development
PORT=4000

# JWT signing secret — use a long random value in production
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=8h

# PostgreSQL connection (used by the Prisma production adapter)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/attendance?schema=public

# Data adapter: "memory" (default, runnable with no DB) or "prisma"
DATA_ADAPTER=memory

# Slack — signing secret used to verify inbound event/webhook requests
SLACK_SIGNING_SECRET=change-me

# Sign in with Slack (OpenID Connect). From your Slack app's "Basic Information".
# Redirect URL must be added under OAuth & Permissions in the Slack app.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_OAUTH_REDIRECT_URL=http://localhost:4000/api/auth/slack/callback

# Env-driven Slack workspace (single-company deployment). With these set there is
# no Slack config UI — the bot token auto-attaches to your company on login and
# powers "Sync from Slack". SLACK_BOT_TOKEN is the xoxb- token from OAuth & Perms.
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=
SLACK_WORKSPACE_NAME=

# Where the backend redirects the browser after a successful/failed Slack login.
FRONTEND_URL=http://localhost:5173

# Anthropic / Claude — server-side only, never exposed to the frontend
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# CORS allowed origin for the frontend
CORS_ORIGIN=http://localhost:5173
