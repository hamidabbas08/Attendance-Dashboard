{
  "name": "attendance-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant HR/Attendance SaaS — run backend + frontend together",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "setup": "pnpm install",
    "dev": "concurrently -k -n backend,frontend -c blue,magenta \"pnpm --filter ./backend dev\" \"pnpm --filter ./frontend dev\"",
    "build": "pnpm --filter ./backend build && pnpm --filter ./frontend build",
    "start": "concurrently -k -n backend,frontend -c blue,magenta \"pnpm --filter ./backend start\" \"pnpm --filter ./frontend start\"",
    "test": "pnpm --filter ./backend test"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "prisma"]
  }
}
